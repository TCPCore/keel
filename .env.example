# Meta Model API (Muse Spark is the judge and the black-box target)
# The cookbook variable is MODEL_API_KEY; META_API_KEY is accepted as an alias.
MODEL_API_KEY=
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
KEEL_JUDGE_MODEL=muse-spark-1.3

# Meta open weights (gated download)
HF_TOKEN=

# Baseten (training jobs + batch checkpoint jobs)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# The acceptance email says meta-models/muse-spark-open-1026, but that id
# returns 404 on this key; the catalog serves meta-models/muse-spark-open.
BASETEN_MODEL_ID=meta-models/muse-spark-open

# Modal (demo endpoint, interactive scans)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional: pin a reference checkpoint
KEEL_REFERENCE=muse-glimmer-30b-base
